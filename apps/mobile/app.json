{
  "expo": {
    "name": "JustSwap",
    "slug": "justswap",
    "scheme": "justswap",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "me.justswap.app",
      "buildNumber": "4",
      "icon": "./assets/icon-ios.png",
      "associatedDomains": [
        "applinks:justswap.me"
      ],
      "infoPlist": {
        "CFBundleLocalizations": [
          "ar",
          "en"
        ],
        "CFBundleDevelopmentRegion": "en",
        "ITSAppUsesNonExemptEncryption": false
      },
      "privacyManifests": {
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": [
              "CA92.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryFileTimestamp",
            "NSPrivacyAccessedAPITypeReasons": [
              "0A2A.1",
              "C617.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategorySystemBootTime",
            "NSPrivacyAccessedAPITypeReasons": [
              "35F9.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryDiskSpace",
            "NSPrivacyAccessedAPITypeReasons": [
              "E174.1"
            ]
          }
        ]
      }
    },
    "android": {
      "package": "me.justswap.app",
      "versionCode": 5,
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0A0E1A"
      },
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "justswap.me",
              "pathPrefix": "/en/listings"
            },
            {
              "scheme": "https",
              "host": "justswap.me",
              "pathPrefix": "/ar/listings"
            },
            {
              "scheme": "https",
              "host": "justswap.me",
              "pathPrefix": "/en/users"
            },
            {
              "scheme": "https",
              "host": "justswap.me",
              "pathPrefix": "/ar/users"
            },
            {
              "scheme": "https",
              "host": "justswap.me",
              "pathPrefix": "/en/messages"
            },
            {
              "scheme": "https",
              "host": "justswap.me",
              "pathPrefix": "/ar/messages"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "favicon": "./assets/icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "backgroundColor": "#0A0E1A",
          "resizeMode": "contain",
          "imageWidth": 200
        }
      ],
      "expo-localization",
      "./plugins/withAndroidRtlEarlySet",
      [
        "expo-image-picker",
        {
          "photosPermission": "JustSwap needs access to your photos so you can add pictures to your listings and profile.",
          "cameraPermission": "JustSwap needs access to your camera so you can take photos for your listings.",
          "microphonePermission": false
        }
      ],
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "JustSwap can use Face ID to unlock the app when you turn on the app lock."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "tsconfigPaths": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "9f8660e2-f233-4eeb-a578-776367ebec8e"
      }
    },
    "owner": "most.othman"
  }
}
