{
  "expo": {
    "name": "JustSwap",
    "slug": "justswap",
    "scheme": "justswap",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "me.justswap.app",
      "associatedDomains": [
        "applinks:justswap.me"
      ],
      "infoPlist": {
        "CFBundleLocalizations": [
          "ar",
          "en"
        ],
        "CFBundleDevelopmentRegion": "en"
      }
    },
    "android": {
      "package": "me.justswap.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0A0E1A"
      },
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "justswap.me",
              "pathPrefix": "/en/listings"
            },
            {
              "scheme": "https",
              "host": "justswap.me",
              "pathPrefix": "/ar/listings"
            },
            {
              "scheme": "https",
              "host": "justswap.me",
              "pathPrefix": "/en/users"
            },
            {
              "scheme": "https",
              "host": "justswap.me",
              "pathPrefix": "/ar/users"
            },
            {
              "scheme": "https",
              "host": "justswap.me",
              "pathPrefix": "/en/messages"
            },
            {
              "scheme": "https",
              "host": "justswap.me",
              "pathPrefix": "/ar/messages"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "favicon": "./assets/icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "backgroundColor": "#0A0E1A",
          "resizeMode": "contain",
          "imageWidth": 200
        }
      ],
      "expo-localization",
      "./plugins/withAndroidRtlEarlySet",
      [
        "expo-image-picker",
        {
          "photosPermission": "JustSwap needs access to your photos so you can add pictures to your listings and profile.",
          "cameraPermission": "JustSwap needs access to your camera so you can take photos for your listings.",
          "microphonePermission": false
        }
      ],
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "tsconfigPaths": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "9f8660e2-f233-4eeb-a578-776367ebec8e"
      }
    },
    "owner": "most.othman"
  }
}
